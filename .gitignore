.ipynb_checkpoints/

# ==========================================================
# Machine Learning
# ==========================================================
# Leading slashes anchor these to the repository root on purpose. Without one,
# "models/" and "data/" match a directory of that name at *any* depth, which
# silently excluded the src/sku_mapping/data package - loaders, validators,
# preprocessing, offer identity - from being tracked at all.
/checkpoints/
*.joblib
*.pkl
*.h5
*.onnx

# Exception: the registered model package is tracked. config/default.yaml pins
# ml.model_id and sets require_registered_model, so a clone without these files
# cannot score at all - the dashboard fails closed and nine tests error on the
# missing registry. 5.5 MB is worth a clone that runs.
!/models/**

# ==========================================================
# Outputs
# ==========================================================
/reports/
/figures/
/outputs/

# ==========================================================
# Large datasets
# ==========================================================
/data/
/datasets/
/raw_data/
/processed_data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ==========================================================
# Cache
# ==========================================================
.cache/
.pytest_cache/
.mypy_cache/

# ==========================================================
# Temporary files
# ==========================================================
*.tmp
*.bak

# Temporary
.codex_tmp/

# Streamlit local secrets
.streamlit/secrets.toml

# Node
node_modules/

# npm
package-lock.json
npm-debug.log*

# Office lock files (e.g. ~$Product_Master.xlsx) created while a workbook
# is open. Transient, machine-local, never meaningful to commit.
~$*
